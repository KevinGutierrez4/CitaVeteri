
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid px-4 py-4">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Dashboard
            </h1>

            <p class="text-muted mb-0">
                Resumen general de la Clínica Veterinaria
            </p>
        </div>

        <div>
            <span class="badge bg-success px-3 py-2">
                <i class="bi bi-circle-fill me-1"></i>
                Sistema activo
            </span>
        </div>

    </div>


    <!-- TARJETAS DE ESTADÍSTICAS -->
    <div class="row g-4 mb-4">

        <!-- SERVICIOS -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Servicios
                            </p>

                            <h2 class="fw-bold mb-0">
                                @ViewBag.TotalServicios
                            </h2>

                            <small class="text-muted">
                                Servicios registrados
                            </small>

                        </div>

                        <div class="rounded-circle bg-primary bg-opacity-10 p-3">

                            <i class="bi bi-heart-pulse-fill fs-3 text-primary"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- MASCOTAS -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Mascotas
                            </p>

                            <h2 class="fw-bold mb-0">
                                @ViewBag.TotalMascotas
                            </h2>

                            <small class="text-muted">
                                Mascotas registradas
                            </small>

                        </div>

                        <div class="rounded-circle bg-success bg-opacity-10 p-3">

                            <i class="bi bi-emoji-smile-fill fs-3 text-success"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- USUARIOS -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Usuarios
                            </p>

                            <h2 class="fw-bold mb-0">
                                @ViewBag.TotalUsuarios
                            </h2>

                            <small class="text-muted">
                                Usuarios registrados
                            </small>

                        </div>

                        <div class="rounded-circle bg-warning bg-opacity-10 p-3">

                            <i class="bi bi-people-fill fs-3 text-warning"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- CITAS -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Citas
                            </p>

                            <h2 class="fw-bold mb-0">
                                @ViewBag.TotalCitas
                            </h2>

                            <small class="text-muted">
                                Citas registradas
                            </small>

                        </div>

                        <div class="rounded-circle bg-danger bg-opacity-10 p-3">

                            <i class="bi bi-calendar-check-fill fs-3 text-danger"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- CONTENIDO PRINCIPAL -->
    <div class="row g-4">

        <!-- GRÁFICO -->
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div>

                            <h5 class="fw-bold mb-1">
                                Citas por mes
                            </h5>

                            <p class="text-muted small mb-0">
                                Cantidad de citas registradas durante el año
                            </p>

                        </div>

                        <span class="badge bg-light text-dark">
                            Estadísticas
                        </span>

                    </div>

                    <div style="height: 350px;">
                        <canvas id="graficoCitas"></canvas>
                    </div>

                </div>

            </div>

        </div>


        <!-- PANEL INFORMACIÓN -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-4">
                        Resumen del sistema
                    </h5>

                    <div class="d-flex align-items-center mb-4">

                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">

                            <i class="bi bi-hospital fs-4 text-primary"></i>

                        </div>

                        <div>

                            <h6 class="mb-1">
                                Clínica Veterinaria
                            </h6>

                            <small class="text-muted">
                                Sistema de gestión
                            </small>

                        </div>

                    </div>


                    <div class="border-top pt-3 mb-3">

                        <div class="d-flex justify-content-between mb-3">

                            <span class="text-muted">
                                Servicios registrados
                            </span>

                            <strong>
                                @ViewBag.TotalServicios
                            </strong>

                        </div>

                        <div class="d-flex justify-content-between mb-3">

                            <span class="text-muted">
                                Mascotas registradas
                            </span>

                            <strong>
                                @ViewBag.TotalMascotas
                            </strong>

                        </div>

                        <div class="d-flex justify-content-between mb-3">

                            <span class="text-muted">
                                Usuarios registrados
                            </span>

                            <strong>
                                @ViewBag.TotalUsuarios
                            </strong>

                        </div>

                        <div class="d-flex justify-content-between">

                            <span class="text-muted">
                                Total de citas
                            </span>

                            <strong>
                                @ViewBag.TotalCitas
                            </strong>

                        </div>

                    </div>


                    <div class="alert alert-primary border-0 mt-4">

                        <div class="d-flex">

                            <i class="bi bi-info-circle-fill me-2"></i>

                            <small>
                                Los datos mostrados se obtienen
                                directamente de la base de datos.
                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ACCIONES RÁPIDAS -->
    <div class="card border-0 shadow-sm mt-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">
                Acciones rápidas
            </h5>

            <div class="d-flex flex-wrap gap-2">

                <a asp-controller="ServiciosVeterinarios"
                   asp-action="Index"
                   class="btn btn-primary">

                    <i class="bi bi-heart-pulse me-1"></i>
                    Servicios

                </a>

                <a asp-controller="Citas"
                   asp-action="Index"
                   class="btn btn-success">

                    <i class="bi bi-calendar-check me-1"></i>
                    Ver citas

                </a>

                <a asp-controller="Reportes"
                   asp-action="Index"
                   class="btn btn-dark">

                    <i class="bi bi-file-earmark-pdf me-1"></i>
                    Reportes

                </a>

            </div>

        </div>

    </div>

</div>


<!-- BOOTSTRAP ICONS -->
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


<!-- CHART.JS -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<script>

    const meses = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        ViewBag.Meses
                )
        );

    const cantidades = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        ViewBag.Cantidades
                )
        );


    const ctx =
        document.getElementById('graficoCitas');


    new Chart(ctx, {

        type: 'bar',

        data: {

            labels: meses,

            datasets: [

                {

                    label: 'Citas',

                    data: cantidades,

                    borderWidth: 1,

                    borderRadius: 6

                }

            ]

        },

        options: {

            responsive: true,

            maintainAspectRatio: false,

            plugins: {

                legend: {

                    display: false

                }

            },

            scales: {

                y: {

                    beginAtZero: true,

                    ticks: {

                        precision: 0

                    }

                }

            }

        }

    });

</script>

