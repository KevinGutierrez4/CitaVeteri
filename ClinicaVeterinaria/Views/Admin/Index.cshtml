@{
    ViewData["Title"] = "Panel de Administrador";
}

<div class="container mt-4">

    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5">
                Panel de Administrador
            </h1>

            <p class="text-muted">
                Bienvenido al sistema de gestión de la Clínica Veterinaria.
            </p>
        </div>
    </div>

    <div class="row g-4">

        <!-- Servicios -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">
                        Servicios
                    </h5>

                    <p class="card-text">
                        Gestiona los servicios veterinarios.
                    </p>

                    <a asp-controller="ServiciosVeterinarios"
                       asp-action="Index"
                       class="btn btn-primary">
                        Gestionar servicios
                    </a>
                </div>
            </div>
        </div>

        <!-- Citas -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">

                    <h5 class="card-title">
                        Citas
                    </h5>

                    <p class="card-text">
                        Consulta las citas registradas.
                    </p>

                    <a asp-controller="Citas"
                       asp-action="Index"
                       class="btn btn-success">
                        Ver citas
                    </a>

                </div>
            </div>
        </div>

        <!-- Dashboard -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">

                    <h5 class="card-title">
                        Dashboard
                    </h5>

                    <p class="card-text">
                        Visualiza estadísticas de la clínica.
                    </p>

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="btn btn-info text-white">
                        Ver dashboard
                    </a>

                </div>
            </div>
        </div>

        <!-- Reportes -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">

                    <h5 class="card-title">
                        Reportes
                    </h5>

                    <p class="card-text">
                        Genera los reportes del sistema.
                    </p>

                    <a asp-controller="Reportes"
                       asp-action="Index"
                       class="btn btn-dark">
                        Ver reportes
                    </a>

                </div>
            </div>
        </div>

    </div>

</div>
