@model ClinicaVeterinaria.Models.Mascota

@{
    ViewData["Title"] = "Eliminar Mascota";
}

<div class="container mt-4">

    <h1>Eliminar Mascota</h1>

    <div class="alert alert-danger">

        <h4>¿Está seguro de eliminar esta mascota?</h4>

        <p>
            Esta acción no se puede deshacer.
        </p>

    </div>

    <dl class="row">

        <dt class="col-sm-3">
            Nombre
        </dt>

        <dd class="col-sm-9">
            @Model.Nombre
        </dd>

        <dt class="col-sm-3">
            Especie
        </dt>

        <dd class="col-sm-9">
            @Model.Especie
        </dd>

        <dt class="col-sm-3">
            Raza
        </dt>

        <dd class="col-sm-9">
            @Model.Raza
        </dd>

    </dl>

    <form asp-action="Delete">

        <input type="hidden"
               asp-for="Id" />

        <button type="submit"
                class="btn btn-danger">
            Sí, eliminar
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>
