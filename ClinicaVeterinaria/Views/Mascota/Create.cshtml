@model ClinicaVeterinaria.Models.Mascota

@{
    ViewData["Title"] = "Registrar Mascota";
}

<div class="container mt-4">

    <h1>Registrar Mascota</h1>

    <hr />

    <div class="row">

        <div class="col-md-6">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <div class="mb-3">

                    <label asp-for="Nombre"
                           class="form-label">
                    </label>

                    <input asp-for="Nombre"
                           class="form-control" />

                    <span asp-validation-for="Nombre"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Especie"
                           class="form-label">
                    </label>

                    <input asp-for="Especie"
                           class="form-control"
                           placeholder="Perro, gato, etc." />

                    <span asp-validation-for="Especie"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Raza"
                           class="form-label">
                    </label>

                    <input asp-for="Raza"
                           class="form-control" />

                    <span asp-validation-for="Raza"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Guardar
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
