@model ClinicaVeterinaria.Models.ServicioVeterinario

@{
    ViewData["Title"] = "Eliminar Servicio";
}

<div class="container mt-4">

    <h1>Eliminar Servicio</h1>

    <div class="alert alert-danger mt-3">
        ¿Estás seguro de que deseas eliminar este servicio?
    </div>

    <div class="card">

        <div class="card-body">

            <h4>@Model.Nombre</h4>

            <hr />

            <dl class="row">

                <dt class="col-sm-3">
                    Nombre
                </dt>

                <dd class="col-sm-9">
                    @Model.Nombre
                </dd>

                <dt class="col-sm-3">
                    Descripción
                </dt>

                <dd class="col-sm-9">
                    @Model.Descripcion
                </dd>

                <dt class="col-sm-3">
                    Precio
                </dt>

                <dd class="col-sm-9">
                    Bs. @Model.Precio.ToString("0.00")
                </dd>

            </dl>

            <form asp-action="Delete"
                  method="post">

                <input type="hidden"
                       asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger">
                    Sí, eliminar
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>

    </div>

</div>