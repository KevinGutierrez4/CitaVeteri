
@model IEnumerable<ClinicaVeterinaria.Models.ServicioVeterinario>

@{
    ViewData["Title"] = "Servicios Veterinarios";
}

<div class="container py-5">

    <!-- ENCABEZADO -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-5">

        <div>

            <span class="section-label">
                ATENCIÓN VETERINARIA
            </span>

            <h1 class="vet-title mt-2 mb-2">
                Servicios Veterinarios
            </h1>

            <p class="text-muted mb-0">
                Conoce los servicios disponibles para el cuidado de tus mascotas.
            </p>

        </div>


        @if (User.IsInRole("Administrador"))
        {
            <div class="mt-3 mt-md-0">

                <a asp-action="Create"
                   class="btn btn-vet px-4">

                    <i class="bi bi-plus-circle-fill me-1"></i>

                    Nuevo servicio

                </a>

            </div>
        }

    </div>


    <!-- SERVICIOS -->
    @if (!Model.Any())
    {
        <div class="vet-card p-5 text-center">

            <div class="vet-icon mx-auto mb-3">

                <i class="bi bi-heart-pulse"></i>

            </div>

            <h4 class="vet-title">
                No hay servicios registrados
            </h4>

            <p class="text-muted mb-0">
                Actualmente no existen servicios veterinarios disponibles.
            </p>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var servicio in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="service-vet-card h-100">

                        <div class="service-vet-header">

                            <div class="service-vet-icon">

                                <i class="bi bi-heart-pulse-fill"></i>

                            </div>

                            <span class="service-price">

                                Bs. @servicio.Precio.ToString("N2")

                            </span>

                        </div>


                        <div class="service-vet-body">

                            <h4>
                                @servicio.Nombre
                            </h4>

                            <p>
                                @servicio.Descripcion
                            </p>

                        </div>


                        <div class="service-vet-footer">

                            <a asp-action="Details"
                               asp-route-id="@servicio.Id"
                               class="btn btn-outline-success btn-sm">

                                <i class="bi bi-eye"></i>
                                Ver detalles

                            </a>


                            @if (User.IsInRole("Administrador"))
                            {
                                <div class="d-flex gap-1">

                                    <a asp-action="Edit"
                                       asp-route-id="@servicio.Id"
                                       class="btn btn-warning btn-sm">

                                        <i class="bi bi-pencil-fill"></i>

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@servicio.Id"
                                       class="btn btn-danger btn-sm">

                                        <i class="bi bi-trash-fill"></i>

                                    </a>

                                </div>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>


<style>

    .section-label {
        color: #19a974;
        font-size: .8rem;
        font-weight: 800;
        letter-spacing: 2px;
    }


    /* TARJETA DE SERVICIO */

    .service-vet-card {

        background: white;

        border-radius: 20px;

        overflow: hidden;

        box-shadow:
            0 7px 25px
            rgba(23, 76, 60, .08);

        border: 1px solid #edf4f1;

        transition:
            transform .25s,
            box-shadow .25s;

    }


    .service-vet-card:hover {

        transform: translateY(-6px);

        box-shadow:
            0 15px 35px
            rgba(23, 76, 60, .14);

    }


    /* CABECERA */

    .service-vet-header {

        display: flex;

        justify-content: space-between;

        align-items: center;

        padding: 25px 25px 15px;

    }


    .service-vet-icon {

        width: 55px;
        height: 55px;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 15px;

        background: #dff7ee;

        color: #087f5b;

        font-size: 1.5rem;

    }


    .service-price {

        background: #effbf7;

        color: #087f5b;

        font-weight: 800;

        padding: 7px 12px;

        border-radius: 20px;

        font-size: .9rem;

    }


    /* CUERPO */

    .service-vet-body {

        padding: 5px 25px 25px;

    }


    .service-vet-body h4 {

        color: #174c3c;

        font-weight: 700;

        margin-bottom: 10px;

    }


    .service-vet-body p {

        color: #6c757d;

        line-height: 1.6;

        min-height: 75px;

        margin-bottom: 0;

    }


    /* FOOTER */

    .service-vet-footer {

        padding: 15px 25px;

        border-top: 1px solid #edf4f1;

        display: flex;

        justify-content: space-between;

        align-items: center;

    }


    @@media (max-width: 576px) {

        .service-vet-footer {

            flex-direction: column;

            align-items: stretch;

            gap: 10px;

        }

        .service-vet-footer .d-flex {

            justify-content: flex-end;

        }

    }

</style>

