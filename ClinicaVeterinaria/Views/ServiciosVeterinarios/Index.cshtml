@model IEnumerable<ClinicaVeterinaria.Models.ServicioVeterinario>

@{
    ViewData["Title"] = "Servicios Veterinarios";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Servicios Veterinarios</h1>
            <p class="text-muted">
                Servicios disponibles en la clínica.
            </p>
        </div>

        @if (User.IsInRole("Administrador"))
        {
            <a asp-action="Create" class="btn btn-primary">
                + Nuevo Servicio
            </a>
        }

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No existen servicios registrados.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover">

                <thead class="table-primary">
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Precio</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var servicio in Model)
                    {
                        <tr>
                            <td>
                                @servicio.Nombre
                            </td>

                            <td>
                                @servicio.Descripcion
                            </td>

                            <td>
                                Bs. @servicio.Precio.ToString("0.00")
                            </td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@servicio.Id"
                                   class="btn btn-info btn-sm text-white">
                                    Ver
                                </a>

                                @if (User.IsInRole("Administrador"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@servicio.Id"
                                       class="btn btn-warning btn-sm">
                                        Editar
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@servicio.Id"
                                       class="btn btn-danger btn-sm">
                                        Eliminar
                                    </a>
                                }

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
