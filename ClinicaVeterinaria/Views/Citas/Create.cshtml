
@model ClinicaVeterinaria.Models.Cita

@{
    ViewData["Title"] = "Solicitar Cita";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow">

                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        Solicitar Cita
                    </h3>
                </div>

                <div class="card-body">

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <!-- MASCOTA -->

                        <div class="mb-3">

                            <label asp-for="MascotaId"
                                   class="form-label">
                                Mascota
                            </label>

                            <select asp-for="MascotaId"
                                    class="form-select"
                                    asp-items="ViewBag.MascotaId">

                                <option value="">
                                    -- Seleccione una mascota --
                                </option>

                            </select>

                            <span asp-validation-for="MascotaId"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- SERVICIO -->

                        <div class="mb-3">

                            <label asp-for="ServicioVeterinarioId"
                                   class="form-label">
                                Servicio veterinario
                            </label>

                            <select asp-for="ServicioVeterinarioId"
                                    class="form-select"
                                    asp-items="ViewBag.ServicioVeterinarioId">

                                <option value="">
                                    -- Seleccione un servicio --
                                </option>

                            </select>

                            <span asp-validation-for="ServicioVeterinarioId"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- FECHA -->

                        <div class="mb-3">

                            <label asp-for="FechaCita"
                                   class="form-label">
                                Fecha de atención
                            </label>

                            <input asp-for="FechaCita"
                                   type="date"
                                   class="form-control"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />

                            <span asp-validation-for="FechaCita"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- BOTONES -->

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Solicitar cita
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancelar
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

