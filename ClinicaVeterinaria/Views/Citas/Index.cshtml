
@model IEnumerable<ClinicaVeterinaria.Models.Cita>

@{
    ViewData["Title"] = "Mis Citas";
}

<div class="container py-5">

    <!-- ENCABEZADO -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-5">

        <div>
            <span class="section-label">
                ATENCIÓN VETERINARIA
            </span>

            <h1 class="vet-title mt-2 mb-2">
                Mis Citas
            </h1>

            <p class="text-muted mb-0">
                Consulta y administra tus citas veterinarias.
            </p>
        </div>

        @if (User.IsInRole("Cliente"))
        {
            <div class="mt-3 mt-md-0">
                <a asp-action="Create"
                   class="btn btn-vet px-4">

                    <i class="bi bi-calendar-plus-fill me-1"></i>
                    Solicitar cita

                </a>
            </div>
        }

    </div>


    <!-- LISTADO -->

    @if (!Model.Any())
    {
        <div class="vet-card p-5 text-center">

            <div class="empty-icon mx-auto mb-3">
                <i class="bi bi-calendar-heart"></i>
            </div>

            <h4 class="vet-title">
                No hay citas registradas
            </h4>

            <p class="text-muted mb-4">
                Todavía no tienes citas veterinarias registradas.
            </p>

            @if (User.IsInRole("Cliente"))
            {
                <a asp-action="Create"
                   class="btn btn-vet">

                    <i class="bi bi-calendar-plus me-1"></i>
                    Solicitar mi primera cita

                </a>
            }

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var cita in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="appointment-card h-100">

                        <!-- FECHA -->

                        <div class="appointment-date">

                            <div class="date-icon">
                                <i class="bi bi-calendar-event-fill"></i>
                            </div>

                            <div>
                                <small>Fecha de atención</small>

                                <strong>
                                    @cita.FechaCita.ToString("dd/MM/yyyy")
                                </strong>
                            </div>

                        </div>


                        <!-- INFORMACIÓN -->

                        <div class="appointment-body">

                            <div class="appointment-info">

                                <i class="bi bi-heart-fill"></i>

                                <div>
                                    <small>Mascota</small>

                                    <strong>
                                        @cita.Mascota.Nombre
                                    </strong>
                                </div>

                            </div>


                            <div class="appointment-info">

                                <i class="bi bi-heart-pulse-fill"></i>

                                <div>
                                    <small>Servicio</small>

                                    <strong>
                                        @cita.ServicioVeterinario.Nombre
                                    </strong>
                                </div>

                            </div>


                            <div class="appointment-status">

                                @if (cita.Estado == "Pendiente")
                                {
                                    <span class="status pending">
                                        <i class="bi bi-clock-fill"></i>
                                        Pendiente
                                    </span>
                                }
                                else if (cita.Estado == "Atendida")
                                {
                                    <span class="status attended">
                                        <i class="bi bi-check-circle-fill"></i>
                                        Atendida
                                    </span>
                                }
                                else
                                {
                                    <span class="status cancelled">
                                        <i class="bi bi-x-circle-fill"></i>
                                        Cancelada
                                    </span>
                                }

                            </div>

                        </div>


                        <!-- ACCIONES -->

                        <div class="appointment-footer">

                            <a asp-action="Details"
                               asp-route-id="@cita.Id"
                               class="btn btn-outline-success btn-sm">

                                <i class="bi bi-eye"></i>
                                Ver detalles

                            </a>

                            @if (User.IsInRole("Administrador"))
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@cita.Id"
                                   class="btn btn-warning btn-sm">

                                    <i class="bi bi-pencil-fill"></i>
                                    Estado

                                </a>
                            }

                            @if (User.IsInRole("Cliente") &&
                                 cita.Estado == "Pendiente")
                            {
                                <a asp-action="Delete"
                                   asp-route-id="@cita.Id"
                                   class="btn btn-danger btn-sm">

                                    <i class="bi bi-x-circle-fill"></i>
                                    Cancelar

                                </a>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>


<style>

    .section-label {

        color: #19a974;

        font-size: .8rem;

        font-weight: 800;

        letter-spacing: 2px;

    }


    /* TARJETA */

    .appointment-card {

        background: white;

        border-radius: 22px;

        overflow: hidden;

        border: 1px solid #edf4f1;

        box-shadow:
            0 7px 25px
            rgba(23, 76, 60, .08);

        transition:
            transform .25s,
            box-shadow .25s;

    }


    .appointment-card:hover {

        transform: translateY(-6px);

        box-shadow:
            0 15px 35px
            rgba(23, 76, 60, .14);

    }


    /* FECHA */

    .appointment-date {

        display: flex;

        align-items: center;

        gap: 15px;

        padding: 22px 25px;

        background: #f3fbf8;

        border-bottom: 1px solid #e5f2ed;

    }


    .date-icon {

        width: 52px;

        height: 52px;

        border-radius: 15px;

        background: #19a974;

        color: white;

        display: flex;

        align-items: center;

        justify-content: center;

        font-size: 1.3rem;

    }


    .appointment-date small {

        display: block;

        color: #6c757d;

        font-size: .75rem;

        margin-bottom: 2px;

    }


    .appointment-date strong {

        color: #174c3c;

        font-size: 1.1rem;

    }


    /* CUERPO */

    .appointment-body {

        padding: 25px;

    }


    .appointment-info {

        display: flex;

        align-items: center;

        gap: 13px;

        margin-bottom: 20px;

    }


    .appointment-info > i {

        color: #19a974;

        font-size: 1.15rem;

    }


    .appointment-info small {

        display: block;

        color: #6c757d;

        font-size: .75rem;

    }


    .appointment-info strong {

        color: #174c3c;

        display: block;

    }


    /* ESTADO */

    .appointment-status {

        margin-top: 10px;

    }


    .status {

        display: inline-flex;

        align-items: center;

        gap: 6px;

        padding: 7px 13px;

        border-radius: 20px;

        font-size: .8rem;

        font-weight: 700;

    }


    .status.pending {

        background: #fff3cd;

        color: #856404;

    }


    .status.attended {

        background: #d1e7dd;

        color: #0f5132;

    }


    .status.cancelled {

        background: #f8d7da;

        color: #842029;

    }


    /* FOOTER */

    .appointment-footer {

        border-top: 1px solid #edf4f1;

        padding: 15px 20px;

        display: flex;

        gap: 7px;

        flex-wrap: wrap;

    }


    .appointment-footer .btn {

        flex: 1;

    }


    /* VACÍO */

    .empty-icon {

        width: 75px;

        height: 75px;

        border-radius: 50%;

        background: #dff7ee;

        color: #19a974;

        display: flex;

        align-items: center;

        justify-content: center;

        font-size: 2rem;

    }


    @@media (max-width: 576px) {

        .appointment-footer {

            flex-direction: column;

        }

        .appointment-footer .btn {

            width: 100%;

        }

    }

</style>

