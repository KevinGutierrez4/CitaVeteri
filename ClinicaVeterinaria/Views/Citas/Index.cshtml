@model IEnumerable<ClinicaVeterinaria.Models.Cita>

@{
    ViewData["Title"] = "Citas";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            @if (User.IsInRole("Administrador"))
            {
                <h1>Todas las Citas</h1>
                <p class="text-muted">
                    Administración de las citas de la clínica.
                </p>
            }
            else
            {
                <h1>Mis Citas</h1>
                <p class="text-muted">
                    Citas de mis mascotas.
                </p>
            }
        </div>

        @if (User.IsInRole("Cliente"))
        {
            <a asp-action="Create" class="btn btn-primary">
                + Solicitar Cita
            </a>
        }

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No hay citas registradas.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover">

                <thead class="table-primary">
                    <tr>
                        <th>Mascota</th>
                        <th>Servicio</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var cita in Model)
                    {
                        <tr>

                            <td>
                                @cita.Mascota?.Nombre
                            </td>

                            <td>
                                @cita.ServicioVeterinario?.Nombre
                            </td>

                            <td>
                                @cita.FechaCita.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>

                                @if (cita.Estado == "Pendiente")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pendiente
                                    </span>
                                }
                                else if (cita.Estado == "Atendida")
                                {
                                    <span class="badge bg-success">
                                        Atendida
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Cancelada
                                    </span>
                                }

                            </td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@cita.Id"
                                   class="btn btn-info btn-sm text-white">
                                    Ver
                                </a>

                                @if (User.IsInRole("Administrador"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@cita.Id"
                                       class="btn btn-warning btn-sm">
                                        Editar
                                    </a>
                                }

                                @if (cita.Estado == "Pendiente")
                                {
                                    <a asp-action="Delete"
                                       asp-route-id="@cita.Id"
                                       class="btn btn-danger btn-sm">
                                        Cancelar
                                    </a>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
