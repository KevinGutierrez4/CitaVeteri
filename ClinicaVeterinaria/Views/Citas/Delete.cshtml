@model ClinicaVeterinaria.Models.Cita

@{
    ViewData["Title"] = "Cancelar Cita";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm">

                <div class="card-header bg-danger text-white">

                    <h4 class="mb-0">
                        Cancelar Cita
                    </h4>

                </div>

                <div class="card-body">

                    <div class="alert alert-warning">

                        <strong>
                            ¿Está seguro de cancelar esta cita?
                        </strong>

                        <br />

                        Esta acción cambiará el estado de la cita a
                        <strong>Cancelada</strong>.

                    </div>

                    <dl class="row">

                        <dt class="col-sm-4">
                            Mascota
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Mascota?.Nombre
                        </dd>


                        <dt class="col-sm-4">
                            Servicio
                        </dt>

                        <dd class="col-sm-8">
                            @Model.ServicioVeterinario?.Nombre
                        </dd>


                        <dt class="col-sm-4">
                            Fecha
                        </dt>

                        <dd class="col-sm-8">
                            @Model.FechaCita.ToString("dd/MM/yyyy HH:mm")
                        </dd>


                        <dt class="col-sm-4">
                            Estado actual
                        </dt>

                        <dd class="col-sm-8">

                            <span class="badge bg-warning text-dark">
                                @Model.Estado
                            </span>

                        </dd>

                    </dl>

                    <hr />

                    <form asp-action="Delete"
                          method="post">

                        <input type="hidden"
                               asp-for="Id" />

                        <button type="submit"
                                class="btn btn-danger">
                            Sí, cancelar cita
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            No, volver
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
