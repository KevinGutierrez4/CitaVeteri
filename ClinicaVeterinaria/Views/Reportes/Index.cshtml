
@model IEnumerable<ClinicaVeterinaria.Data.ApplicationUser>

@{
    ViewData["Title"] = "Reportes";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="fw-bold">
            Reportes
        </h1>

        <p class="text-muted">
            Generación de reportes en formato PDF.
        </p>
    </div>


    <div class="row g-4">

        <!-- REPORTE GENERAL -->

        <div class="col-md-4">

            <div class="card shadow-sm h-100 border-0">

                <div class="card-body text-center p-4">

                    <div class="mb-3">
                        <i class="bi bi-file-earmark-pdf-fill text-danger"
                           style="font-size: 50px;">
                        </i>
                    </div>

                    <h5 class="fw-bold">
                        Listado general de citas
                    </h5>

                    <p class="text-muted">
                        Genera un PDF con todas las citas,
                        mascotas, servicios, fechas y estados.
                    </p>

                    <a asp-action="CitasGeneral"
                       class="btn btn-danger">
                        Generar PDF
                    </a>

                </div>

            </div>

        </div>


        <!-- CITAS POR USUARIO -->

        <div class="col-md-4">

            <div class="card shadow-sm h-100 border-0">

                <div class="card-body p-4">

                    <div class="text-center mb-3">
                        <i class="bi bi-person-lines-fill text-primary"
                           style="font-size: 50px;">
                        </i>
                    </div>

                    <h5 class="fw-bold text-center">
                        Citas por usuario
                    </h5>

                    <p class="text-muted text-center">
                        Selecciona un cliente para generar
                        sus citas en PDF.
                    </p>

                    <form asp-action="CitasPorUsuario"
                          method="get">

                        <select name="usuarioId"
                                class="form-select mb-3"
                                required>

                            <option value="">
                                -- Seleccione un cliente --
                            </option>

                            @foreach (var usuario in Model)
                            {
                                <option value="@usuario.Id">
                                    @usuario.NombreCompleto
                                </option>
                            }

                        </select>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Generar PDF
                        </button>

                    </form>

                </div>

            </div>

        </div>


        <!-- SERVICIOS MÁS SOLICITADOS -->

        <div class="col-md-4">

            <div class="card shadow-sm h-100 border-0">

                <div class="card-body text-center p-4">

                    <div class="mb-3">
                        <i class="bi bi-bar-chart-fill text-success"
                           style="font-size: 50px;">
                        </i>
                    </div>

                    <h5 class="fw-bold">
                        Servicios más solicitados
                    </h5>

                    <p class="text-muted">
                        Muestra los servicios ordenados
                        según la cantidad de citas.
                    </p>

                    <a asp-action="ServiciosMasSolicitados"
                       class="btn btn-success">
                        Generar PDF
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

